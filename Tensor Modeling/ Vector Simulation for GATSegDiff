import numpy as np
from scipy.interpolate import CubicSpline

# =====================================================================
# 1. INPUT REGION: PLUG YOUR VECTOR PATHS HERE
# =====================================================================

# First vector set (moving forward)
vector_set_1 = [
    [1.0, 4.0, 256.0, 256.0],
    [1.0, 64.0, 256.0, 256.0],
    [1.0, 128.0, 128.0, 128.0],
    [1.0, 64.0, 256.0, 256.0],
    [1.0, 4.0, 256.0, 256.0]
     

]

# Second vector set (moving in reverse order)
vector_set_2_reversed = [
   [1.0, 128.0, 128.0, 128.0],
   [1.0, 64.0, 256.0, 256.0],
   [1.0, 1.0, 256.0, 256.0] # Junction point matching set 1
]


# =====================================================================
# 2. DIMENSION-AGNOSTIC DATA CLEANING & COMBINATION
# =====================================================================
# Force inputs into standard 2D matrices, instantly stripping away empty tensor wrappers
arr1 = np.atleast_2d(np.array(vector_set_1, dtype=float))
arr2_rev = np.atleast_2d(np.array(vector_set_2_reversed, dtype=float))

# Dynamically track the number of dimensions from the input data shape
num_points_1, num_dims_1 = arr1.shape
num_points_2, num_dims_2 = arr2_rev.shape

if num_dims_1 != num_dims_2:
    raise ValueError(f"Dimension mismatch! Set 1 has {num_dims_1}D, Set 2 has {num_dims_2}D.")

# Flip the reversed array seamlessly along its primary path sequence axis
arr2_fwd = np.flip(arr2_rev, axis=0)

# Concatenate them end-to-end dynamically along the point sequence axis
raw_combined = np.concatenate((arr1, arr2_fwd), axis=0)

# Drop adjacent duplicate coordinates at the seam to prevent division-by-zero errors
# np.any(..., axis=-1) scales across whatever dimension length your vector possesses
non_duplicate_mask = np.concatenate(([True], np.any(np.diff(raw_combined, axis=0) != 0, axis=-1)))
combined_pts = raw_combined[non_duplicate_mask]

# =====================================================================
# 3. DYNAMIC N-DIMENSIONAL PARAMETERIZATION
# =====================================================================
# Calculate Euclidean distance along N-dimensions: sqrt(Δx₁² + Δx₂² + ... + Δxn²)
deltas = np.diff(combined_pts, axis=0)
segment_lengths = np.linalg.norm(deltas, axis=-1) # axis=-1 scales dynamically to any width
s_accumulated = np.concatenate(([0.0], np.cumsum(segment_lengths)))

# Fit the multi-dimensional cubic spline over total arc distance 's'
cs_master = CubicSpline(s_accumulated, combined_pts, axis=0, bc_type='natural')

# Evenly resample 100 evaluation points across the complete trajectory length
s_uniform = np.linspace(0, s_accumulated[-1], 100)

# Compute position, velocity (1st derivative), and acceleration (2nd derivative)
r_s = cs_master(s_uniform)                
dr_ds = cs_master(s_uniform, nu=1)        
d2r_ds2 = cs_master(s_uniform, nu=2)      

# Curvature (κ₁) calculation (Magnitude of the N-dimensional acceleration vector)
curvature_nd = np.linalg.norm(d2r_ds2, axis=-1)

# Helper function to extract Tangent and Normal frame components across any dimension length
def normalize(v):
    norm = np.linalg.norm(v, axis=-1, keepdims=True)
    return np.divide(v, norm, out=np.zeros_like(v), where=norm!=0)

e1_Tangent = normalize(dr_ds)
e2_Normal = normalize(d2r_ds2)

# =====================================================================
# 4. PRINT GEOMETRIC ANALYSIS SUMMARY
# =====================================================================
print(f"--- Automated {num_dims_1}D Pipeline Summary ---")
print(f"Detected Dimensions:            {num_dims_1}")
print(f"Total Traveled Distance (s):    {s_accumulated[-1]:.4f}")
print(f"Peak Local Curve Curvature:     {np.max(curvature_nd):.4f}")
print(f"Average Local Curve Curvature:  {np.mean(curvature_nd):.4f}")
print(f"\nOutput Matrix Shapes:")
print(f"  Positions Array:              {r_s.shape}")
print(f"  Tangent Frame Array (e1):     {e1_Tangent.shape}")
print(f"  Normal Frame Array (e2):      {e2_Normal.shape}")
