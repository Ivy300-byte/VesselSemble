import torch 
import torch.nn as nn 
from nnunet.network_architecture.generic_UNet import Generic_UNet 
from nnunet.network_architecture.initialization import InitWeights_He 

# 1. Setup architecture configuration parameters
pool_op_kernel_sizes = [(2, 2, 2), (2, 2, 2), (2, 2, 2), (2, 2, 2)] 
conv_kernel_sizes = [(3, 3, 3)] * 5 

official_model = Generic_UNet( 
    input_channels=1, 
    base_num_features=30, 
    num_classes=4, 
    num_pool=len(pool_op_kernel_sizes), 
    num_conv_per_stage=2, 
    feat_map_mul_on_downscale=2, 
    conv_op=nn.Conv3d, 
    norm_op=nn.InstanceNorm3d, 
    norm_op_kwargs={'eps': 1e-5, 'affine': True}, 
    dropout_op=nn.Dropout3d, 
    dropout_op_kwargs={'p': 0}, 
    nonlin=nn.LeakyReLU, 
    nonlin_kwargs={'negative_slope': 1e-2, 'inplace': True}, 
    deep_supervision=True, 
    dropout_in_localization=False, 
    final_nonlin=lambda x: x, 
    weightInitializer=InitWeights_He(1e-2), 
    pool_op_kernel_sizes=pool_op_kernel_sizes, 
    conv_kernel_sizes=conv_kernel_sizes, 
    upscale_logits=False, 
    convolutional_pooling=True, 
    convolutional_upsampling=True 
).eval() 

# 2. Define the unified tracking hook function
def register_shape_hook(module, name_prefix):
    def hook(mod, inp, out):
        # If deep supervision outputs multiple tensors, unpack and print them all
        if isinstance(out, (list, tuple)):
            for idx, o in enumerate(out):
                print(f"[{name_prefix}] Output Head {idx} Shape : {list(o.shape)}")
        else:
            print(f"[{name_prefix}] Output Shape : {list(out.shape)}")
    return module.register_forward_hook(hook)

# 3. Attach hooks directly to target submodule blocks
hooks = []

# Trace all Encoder Steps
for i, layer in enumerate(official_model.conv_blocks_context):
    hooks.append(register_shape_hook(layer, f"Encoder Stage {i}"))

# Trace all Decoder Processing Blocks
for u, layer in enumerate(official_model.conv_blocks_localization):
    hooks.append(register_shape_hook(layer, f"Decoder Localization Step {u}"))

# Trace all Final Deep Supervision Headers
for s, layer in enumerate(official_model.seg_outputs):
    hooks.append(register_shape_hook(layer, f"Deep Supervision Head {s}"))

# 4. Execute a single standard forward pass to trigger prints automatically
print("\n" + "="*20 + " EXECUTING NATIVE NNU-NET FORWARD PASS " + "="*20) 
simulated_volume = torch.randn(1, 1, 64, 64, 64) 

with torch.no_grad():
    _ = official_model(simulated_volume)

print("="*60 + "\n")

# 5. Clean up hooks to keep memory clean
for h in hooks:
    h.remove()
