if __name__ == "__main__":
    # Isotropic Plan Properties typical for 3Dircadb
    ircadb_pool = [(2, 2, 2), (2, 2, 2), (2, 2, 2), (2, 2, 2)]
    ircadb_conv = [(3, 3, 3)] * 5
    
    # Commonly 4 channels for 3Dircadb when segmenting:
    # 0: Background, 1: Liver, 2: Tumors, 3: Internal Venous Systems
    ircadb_classes = 4  

    model = Generic_UNet(
        in_c=1, base_f=30, num_classes=ircadb_classes,
        pool_op_kernel_sizes=ircadb_pool, conv_kernel_sizes=ircadb_conv,
        conv_pooling=True, conv_upsampling=True, deep_supervision=True
    ).eval()

    # Isotropic input tensor cube: [Batch, Channel, Depth (Z), Height (Y), Width (X)]
    # All spatial resolutions contract symmetrically at each level
    simulated_volume = torch.randn(1, 1, 64, 64, 64)
    
    with torch.no_grad():
        _ = model(simulated_volume)
